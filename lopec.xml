<LUPPO>
    <Source>
        <Name>lupus-repo-manager</Name>
        <Homepage>https://github.com/Antolun/lupus-repo-manager</Homepage>
        <Packager>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Packager>
        <License>GPLv3</License>
        <IsA>app:gui</IsA>
        <Summary>LupuS Depo Yöneticisi — Luppo ve Flatpak depolarını yönetin</Summary>
        <Description>Luppo ve Flatpak depolarını tek arayüzden ekleyin, kaldırın, etkinleştirin/devre dışı bırakın ve hız testi yapın.</Description>
    </Source>

    <Package>
        <Name>lupus-repo-manager</Name>
        <RuntimeDependencies>
            <Dependency>luppo</Dependency>
            <Dependency>flatpak</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="executable">/usr/bin/lupus-repo-manager</Path>
            <Path fileType="data">/usr/share/applications/lupus-repo-manager.desktop</Path>
            <Path fileType="data">/usr/share/icons/hicolor/128x128/apps/lupus-repo-manager.png</Path>
            <Path fileType="data">/usr/share/polkit-1/rules.d/50-lupus-repo-manager.rules</Path>
            <Path fileType="config">/etc/sudoers.d/50-lupus-repo-manager</Path>
            <Path fileType="doc">/usr/share/doc/lupus-repo-manager</Path>
        </Files>
    </Package>

    <History>
        <Update release="1">
            <Date>2026-08-30</Date>
            <Version>1.0.0</Version>
            <Comment>Initial release — Luppo &amp; Flatpak repository manager with Tauri UI</Comment>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Update>
    </History>
</LUPPO>
