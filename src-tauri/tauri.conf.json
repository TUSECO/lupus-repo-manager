{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LupuS Repo Manager",
  "version": "1.0.0",
  "identifier": "com.tuseco.lupus-repo-manager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LupuS Repo Manager — Luppo & Flatpak",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "/**",
          "/usr/**",
          "/var/**",
          "/home/**",
          "/opt/**",
          "/tmp/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
